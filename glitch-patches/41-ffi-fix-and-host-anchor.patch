 // touches anything. Reuses the existing platform install primitives
 // (update_me_msi, update_me via the --update relaunch) rather than
 // reimplementing them.
-use hbb_common::{bail, log, ResultType};
+use hbb_common::{bail, config::LocalConfig, log, ResultType};
 use sha2::{Digest, Sha256};
-use std::io::Write;
+use std::{io::Write, sync::Once, time::Duration};
 
 /// Downloads `url`, verifies it against `expected_sha256` (lowercase hex),
 /// and only then dispatches to the platform install path. Runs on the
@@ -84,3 +84,43 @@ fn install_downloaded(file_path: &std::path::Path) -> ResultType<()> {
 fn install_downloaded(_file_path: &std::path::Path) -> ResultType<()> {
     bail!("GL!TCH silent update is not implemented on this platform yet");
 }
+
+const TRIGGER_KEY: &str = "glitch_update_trigger";
+const TRIGGER_POLL_INTERVAL: Duration = Duration::from_secs(2);
+
+static TRIGGER_WATCHER_STARTED: Once = Once::new();
+
+/// Starts (once) a background thread that watches for the Connect "Update
+/// now" button writing `{"url":..,"sha256":..}` into LocalConfig under
+/// `glitch_update_trigger` (see connection_page.dart's _updateNow()).
+/// Deliberately reuses the existing mainSetLocalOption/mainGetLocalOption
+/// bridge calls instead of a new #[frb] function: a brand-new bind function
+/// needs fresh flutter_rust_bridge codegen, which runs as its own CI job
+/// against unpatched upstream source and would never see it - confirmed the
+/// hard way (run #49's build failed: "mainApplyGlitchUpdate isn't defined
+/// for the class 'RustdeskImpl'"). This is exactly why the original
+/// notify-only banner (glitch-18/19) avoided a new FFI surface too.
+pub fn start_trigger_watcher() {
+    TRIGGER_WATCHER_STARTED.call_once(|| {
+        std::thread::spawn(|| loop {
+            std::thread::sleep(TRIGGER_POLL_INTERVAL);
+            let raw = LocalConfig::get_option(TRIGGER_KEY);
+            if raw.is_empty() {
+                continue;
+            }
+            LocalConfig::set_option(TRIGGER_KEY.to_string(), "".to_string());
+            let Ok(value) = serde_json::from_str::<serde_json::Value>(&raw) else {
+                continue;
+            };
+            let (Some(url), Some(sha256)) = (
+                value.get("url").and_then(|v| v.as_str()),
+                value.get("sha256").and_then(|v| v.as_str()),
+            ) else {
+                continue;
+            };
+            if let Err(e) = apply_update(url, sha256) {
+                log::error!("GL!TCH update (button-triggered) failed: {}", e);
+            }
+        });
+    });
+}
