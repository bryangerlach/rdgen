diff --git a/flutter/lib/mobile/widgets/assign_dialog.dart b/flutter/lib/mobile/widgets/assign_dialog.dart
new file mode 100644
index 0000000..b3cf72b
--- /dev/null
+++ b/flutter/lib/mobile/widgets/assign_dialog.dart
@@ -0,0 +1,104 @@
+import 'dart:convert';
+
+import 'package:flutter/material.dart';
+
+import '../../common.dart';
+import '../../models/platform_model.dart';
+import '../../utils/http_service.dart' as http;
+
+const _assignDialogTag = 'android-assign-device';
+
+// GL!TCH: entry point for the rustdesk://assign install-link deep link.
+// Joins this device into a device group using a one-time token issued by
+// the install-link page, hitting the same /api/devices/cli endpoint desktop's
+// `--assign` CLI flow uses (core_main.rs) -- that endpoint is already
+// platform-agnostic, only the CLI entry point is desktop-only.
+void showAssignDialog(
+    {required String token, String? deviceGroupName, String? note}) {
+  gFFI.dialogManager.dismissByTag(_assignDialogTag);
+  var errorText = "";
+  var isInProgress = false;
+  gFFI.dialogManager.show((setState, close, context) {
+    submit() async {
+      if (isInProgress) return;
+      setState(() {
+        errorText = "";
+        isInProgress = true;
+      });
+      try {
+        final apiServer = await bind.mainGetApiServer();
+        final body = <String, dynamic>{
+          'id': await bind.mainGetMyId(),
+          'uuid': await bind.mainGetUuid(),
+        };
+        if (deviceGroupName != null && deviceGroupName.isNotEmpty) {
+          body['device_group_name'] = deviceGroupName;
+        }
+        if (note != null && note.isNotEmpty) {
+          body['note'] = note;
+        }
+        final response = await http.post(
+          Uri.parse('$apiServer/api/devices/cli'),
+          headers: {
+            'Content-Type': 'application/json',
+            'Authorization': 'Bearer $token',
+          },
+          body: json.encode(body),
+        );
+        if (response.statusCode == 200) {
+          close();
+          showToast(translate('Successful'));
+        } else {
+          setState(() {
+            errorText = decode_http_response(response);
+            isInProgress = false;
+          });
+        }
+      } catch (e) {
+        setState(() {
+          errorText = e.toString();
+          isInProgress = false;
+        });
+      }
+    }
+
+    return CustomAlertDialog(
+      title: const Text('Enroll Device'),
+      content: Column(
+        mainAxisSize: MainAxisSize.min,
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Text(deviceGroupName == null || deviceGroupName.isEmpty
+              ? 'Enroll this device?'
+              : 'Enroll this device into "$deviceGroupName"?'),
+          if (errorText.isNotEmpty)
+            Align(
+              alignment: Alignment.centerLeft,
+              child: Padding(
+                padding: const EdgeInsets.only(top: 8),
+                child: SelectableText(
+                  errorText,
+                  style: TextStyle(
+                    color: Theme.of(context).colorScheme.error,
+                    fontSize: 12,
+                  ),
+                ),
+              ),
+            ),
+          if (isInProgress)
+            const Padding(
+              padding: EdgeInsets.only(top: 8),
+              child: LinearProgressIndicator(),
+            ),
+        ],
+      ),
+      actions: [
+        dialogButton("Cancel",
+            onPressed: isInProgress ? null : close, isOutline: true),
+        dialogButton("OK", onPressed: isInProgress ? null : submit),
+      ],
+      onSubmit: submit,
+      onCancel: isInProgress ? null : close,
+    );
+  }, tag: _assignDialogTag);
+}
