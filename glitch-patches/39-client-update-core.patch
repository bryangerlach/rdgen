diff --git a/src/glitch_update.rs b/src/glitch_update.rs
new file mode 100644
index 0000000..7b0844e
--- /dev/null
+++ b/src/glitch_update.rs
@@ -0,0 +1,124 @@
+// GL!TCH: silent self-update (Lawrence, 2026-11-15). Separate from stock
+// RustDesk's own updater.rs (which checks api.rustdesk.com and only
+// verifies downloaded-file size, not a hash) - this is driven entirely by
+// our own ClientRelease data, carried in the existing heartbeat `update`
+// field (see hbbs_http/sync.rs), and requires a matching sha256 before it
+// touches anything. Reuses the existing platform install primitives
+// (update_me_msi, update_me via the --update relaunch) rather than
+// reimplementing them.
+use hbb_common::{bail, config::LocalConfig, log, ResultType};
+use sha2::{Digest, Sha256};
+use std::{io::Write, sync::Once, time::Duration};
+
+/// Downloads `url`, verifies it against `expected_sha256` (lowercase hex),
+/// and only then dispatches to the platform install path. Runs on the
+/// calling thread - callers that must not block (a UI button handler)
+/// should spawn this onto its own thread; see `apply_update_async`.
+pub fn apply_update(url: &str, expected_sha256: &str) -> ResultType<()> {
+    let expected = expected_sha256.trim().to_lowercase();
+    if expected.len() != 64 || !expected.chars().all(|c| c.is_ascii_hexdigit()) {
+        bail!("refusing to apply update: malformed sha256");
+    }
+
+    let client = crate::hbbs_http::create_http_client_with_url_strict(url)?;
+    let response = client.get(url).send()?;
+    if !response.status().is_success() {
+        bail!("failed to download update: {}", response.status());
+    }
+    let bytes = response.bytes()?;
+
+    let mut hasher = Sha256::new();
+    hasher.update(&bytes);
+    let actual = hex::encode(hasher.finalize());
+    if actual != expected {
+        bail!(
+            "update sha256 mismatch: expected {}, got {} - refusing to install",
+            expected,
+            actual
+        );
+    }
+
+    let filename = url
+        .rsplit('/')
+        .next()
+        .filter(|name| !name.is_empty())
+        .unwrap_or("glitch-update");
+    let file_path = std::env::temp_dir().join(filename);
+    {
+        let mut file = std::fs::File::create(&file_path)?;
+        file.write_all(&bytes)?;
+    }
+
+    install_downloaded(&file_path)
+}
+
+/// Same as `apply_update`, but runs on a new thread and only logs on
+/// failure - for callers (a UI button, or the heartbeat handler) that must
+/// not block.
+pub fn apply_update_async(url: String, expected_sha256: String) {
+    std::thread::spawn(move || {
+        if let Err(e) = apply_update(&url, &expected_sha256) {
+            log::error!("GL!TCH update failed: {}", e);
+        }
+    });
+}
+
+#[cfg(target_os = "windows")]
+fn install_downloaded(file_path: &std::path::Path) -> ResultType<()> {
+    let path_str = file_path.to_string_lossy().to_string();
+    if crate::platform::is_msi_installed().unwrap_or(false) {
+        crate::platform::update_me_msi(&path_str, true)
+    } else {
+        let Some(session_id) = crate::platform::get_current_process_session_id() else {
+            bail!("failed to get current process session id");
+        };
+        let cmd = format!("{} --update", path_str);
+        let h = crate::platform::launch_privileged_process(session_id, &cmd)?;
+        if h.is_null() {
+            bail!("failed to launch the downloaded update");
+        }
+        Ok(())
+    }
+}
+
+#[cfg(not(target_os = "windows"))]
+fn install_downloaded(_file_path: &std::path::Path) -> ResultType<()> {
+    bail!("GL!TCH silent update is not implemented on this platform yet");
+}
+
+const TRIGGER_KEY: &str = "glitch_update_trigger";
+const TRIGGER_POLL_INTERVAL: Duration = Duration::from_secs(2);
+
+static TRIGGER_WATCHER_STARTED: Once = Once::new();
+
+/// Starts (once) a background thread that watches for the Connect "Update
+/// now" button writing `{"url":..,"sha256":..}` into LocalConfig under
+/// `glitch_update_trigger` (see connection_page.dart's _updateNow()).
+/// Deliberately reuses the existing mainSetLocalOption/mainGetLocalOption
+/// bridge calls instead of a new #[frb] function: a brand-new bind function
+/// needs fresh flutter_rust_bridge codegen, which runs as its own CI job
+/// against unpatched upstream source and would never see it.
+pub fn start_trigger_watcher() {
+    TRIGGER_WATCHER_STARTED.call_once(|| {
+        std::thread::spawn(|| loop {
+            std::thread::sleep(TRIGGER_POLL_INTERVAL);
+            let raw = LocalConfig::get_option(TRIGGER_KEY);
+            if raw.is_empty() {
+                continue;
+            }
+            LocalConfig::set_option(TRIGGER_KEY.to_string(), "".to_string());
+            let Ok(value) = serde_json::from_str::<serde_json::Value>(&raw) else {
+                continue;
+            };
+            let (Some(url), Some(sha256)) = (
+                value.get("url").and_then(|v| v.as_str()),
+                value.get("sha256").and_then(|v| v.as_str()),
+            ) else {
+                continue;
+            };
+            if let Err(e) = apply_update(url, sha256) {
+                log::error!("GL!TCH update (button-triggered) failed: {}", e);
+            }
+        });
+    });
+}
