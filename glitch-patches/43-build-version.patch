+/// The GitHub Actions run number for this build, sed-replaced by the
+/// generator workflow before compilation (see
+/// "Apply GL!TCH build-version patch"). Appended to crate::VERSION as a 4th
+/// segment when reporting to our own heartbeat, so two GL!TCH builds of the
+/// same upstream tag are actually distinguishable - see sync.rs. Left as
+/// "0" for any build that skips that step (a local dev build, say), which
+/// just means it is never offered as an update to anything (0 never beats
+/// an already-published, real run number).
+pub const GLITCH_BUILD_NUMBER: &str = "0";
+
